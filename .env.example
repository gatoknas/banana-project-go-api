# Database Connection String
# Format: postgres://username:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/your_db_name?sslmode=disable

# API Port Configuration
PORT=8082

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_signing_secret_key

# =============================================================================
# Gmail Bank-Receipt Ingestion
# =============================================================================
# OAuth 2.0 credentials for the Gmail account that receives the bank receipts.
# Obtain these from the Google Cloud Console (OAuth client of type "Web"/"Desktop")
# and generate a refresh token with the https://www.googleapis.com/auth/gmail.readonly scope.
GMAIL_CLIENT_ID=your_gmail_oauth_client_id
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token

# Inbox to read (the "me" user) and optional Gmail label to restrict the search.
GMAIL_TARGET_EMAIL=your_inbox@gmail.com
GMAIL_LABEL=

# Only ingest messages from this sender (Nequi Bre-B receipts).
GMAIL_SENDER_FILTER=notificaciones@nequi.com.co

# Cron expression for the automatic background sync (default: daily at 06:00).
# Leave empty to disable the scheduled sync (manual endpoint still works).
EMAIL_SYNC_CRON=0 6 * * *

