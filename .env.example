# Database Connection String
# Format: postgres://username:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/your_db_name?sslmode=disable

# API Port Configuration
PORT=8082

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_signing_secret_key

# =============================================================================
# Google Sheets Receipt Ingestion
# =============================================================================
# Google Spreadsheet ID containing the bank receipts
GOOGLE_SHEETS_SPREADSHEET_ID=1W_qTHc3RxTwwjCItOwCrRbnI34-63nLuLqG5it5LY7E
# Tab / Sheet name
GOOGLE_SHEETS_RANGE=Datos_Ventas
# Number of rows to read per chunk (default: 500)
GOOGLE_SHEETS_CHUNK_SIZE=500
# Google Service Account credentials (JSON string, base64-encoded JSON, or path via GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Cron expression for optional background sync (leave empty for on-demand endpoint only)
EMAIL_SYNC_CRON=


